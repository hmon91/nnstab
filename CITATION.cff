url: "https://hmon91.github.io/software/"
license: BSD-3-Clause
keywords:
  - "neural networks"
  - "verification"
  - "stability"
  - "region of attraction"
  - "sector bounds"
  - "Lur'e systems"
  - "positive systems"
  - "robust control"
